<?xml version="1.0" encoding="utf-8"?>
<!--
  Secrets (tunnel token, AI API key) live in Keystore-encrypted prefs that
  must never leave the device through backups.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="stratos_secure.xml" />
        <exclude domain="file" path="sites/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stratos_secure.xml" />
        <exclude domain="file" path="sites/" />
    </device-transfer>
</data-extraction-rules>
