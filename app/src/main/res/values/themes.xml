<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light, clean base theme (Compose draws everything; this is the
         platform window scaffold: status bar, splash background). -->
    <style name="Theme.Stratos" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
